<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.cartwise</groupId>
	<artifactId>cartwise-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>cartwise-backend</name>
	<description>CartWise backend service</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
		Chapter 16 adds persistence and nothing else.

		Not present, and why:
		  - No spring-boot-starter-security  -> Chapter 18 (Authentication)
		  - No Flyway/Liquibase              -> schema is generated from the entities for now;
		                                        a migration tool only earns its place once a
		                                        deployed schema exists that must be evolved.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			Brings in Spring Data JPA, Hibernate 7.4.1.Final and HikariCP. The artifact id is
			NOT renamed in Boot 4 the way the web starter was (web -> webmvc); verified against
			repo.maven.apache.org before adding.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
			Version is managed by spring-boot-dependencies (42.7.11 for Boot 4.1.0), so it is
			deliberately not pinned here — the parent and the driver stay in step on upgrade.
			Runtime scope: nothing compiles against the driver, it is looked up by JDBC URL.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
