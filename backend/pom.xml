<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.cartwise</groupId>
	<artifactId>cartwise-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>cartwise-backend</name>
	<description>CartWise backend service</description>

	<properties>
		<java.version>21</java.version>
		<!--
			jjwt is not managed by spring-boot-dependencies, so the version is pinned here.
			It is the one third-party version this project owns, which is why it gets a property
			rather than being repeated across the three artifacts below.
		-->
		<jjwt.version>0.12.3</jjwt.version>
		<!--
			JaCoCo is a build plugin, not a dependency, so spring-boot-dependencies does not manage
			it and the version is this project's to own. 0.8.13 is the floor for Java 21 class files
			(0.8.10 and earlier reject class file major version 65 outright); 0.8.15 is the current
			release and is pinned rather than floated for the same reason the container image is.
		-->
		<jacoco.version>0.8.15</jacoco.version>
	</properties>

	<!--
		Chapter 18 adds authentication. Spring Security and jjwt are new.

		Not present, and why:
		  - No Flyway/Liquibase              -> schema is generated from the entities for now;
		                                        a migration tool only earns its place once a
		                                        deployed schema exists that must be evolved.
		  - No OAuth2 client/resource-server -> social login is a later chapter; this one issues
		                                        its own tokens for its own users.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			Brings in Spring Data JPA, Hibernate 7.4.1.Final and HikariCP. The artifact id is
			NOT renamed in Boot 4 the way the web starter was (web -> webmvc); verified against
			repo.maven.apache.org before adding.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
			Version is managed by spring-boot-dependencies (42.7.11 for Boot 4.1.0), so it is
			deliberately not pinned here — the parent and the driver stay in step on upgrade.
			Runtime scope: nothing compiles against the driver, it is looked up by JDBC URL.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			The whole starter, not just spring-security-crypto.

			Crypto alone would supply BCryptPasswordEncoder and nothing else — no SecurityFilterChain,
			no HttpSecurity, no filter chain to register a JWT filter into, which is most of what this
			chapter needs. The starter brings spring-security-config and spring-security-web as well,
			and crypto comes along inside it.

			Version is managed by the parent: Boot 4.1.0 pins Spring Security 7.1.0. That matters more
			than it sounds — Security 7 removed the chained DSL (`.csrf().disable()`), so only the
			lambda form in SecurityConfig compiles.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			jjwt, split the way its authors intend: the API is compiled against, the implementation
			and the JSON binding are runtime-only. Nothing in this codebase should be able to import
			an io.jsonwebtoken.impl class by accident, and the scopes are what enforce that.

			jjwt-jackson pulls in Jackson 2 (com.fasterxml.jackson.core:jackson-databind) for
			serialising claims. Spring Boot 4 uses Jackson 3 (tools.jackson) for HTTP bodies, so two
			Jackson generations end up on the classpath. They do not collide — the package names are
			entirely different — and each is used by exactly one thing: Jackson 3 for the API's JSON,
			Jackson 2 for the inside of a token. Worth knowing before it looks like an accident.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Test support for authentication. Not strictly required by this chapter's tests, but it is
			the artifact that makes an authenticated request testable without hand-building a token,
			and it belongs next to the starter it supports rather than being remembered later.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Chapter 21 adds tests. Three artifacts, all test-scoped, none of them versioned here
			because spring-boot-dependencies imports the Testcontainers BOM and pins them in step
			with the Boot version.

			spring-boot-testcontainers is the Spring-side glue: @ServiceConnection, which reads a
			started container's host/port/credentials and registers them as the DataSource before
			the context refreshes. Without it the alternative is @DynamicPropertySource and three
			lines of string-building per test class, which is the same thing written by hand and
			wrong more often.

			Why a container at all, rather than H2: application-dev.yml already refuses H2 on the
			grounds that a dialect-compatible fake is how PostgreSQL-specific bugs survive to
			production. A repository test run against H2 would assert that the *fake* behaves —
			the exact thing that is not worth asserting. Container tests run PostgreSQL 17.6, the
			deployed version.

			The cost is honest: these tests need a Docker daemon, so they are guarded (see
			com.cartwise.testsupport.RequiresDocker) and skip rather than fail where none exists.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Note the artifact ids: `testcontainers-junit-jupiter` and `testcontainers-postgresql`,
			NOT `junit-jupiter` and `postgresql`. Testcontainers 2.x renamed every module to carry
			the `testcontainers-` prefix, and Boot 4.1.0 imports testcontainers-bom 2.0.5. The 1.x
			coordinates that most tutorials still show resolve to nothing here, and the error Maven
			gives is "'dependencies.dependency.version' ... is missing" — which reads like a missing
			BOM rather than a wrong artifact id, and sends you looking in the wrong place.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				The test JVM runs in UTC, and this is not a style preference.

				The PostgreSQL JDBC driver sends the client JVM's default time zone to the server as
				the connection's `TimeZone` parameter. This machine's JVM reports `Asia/Calcutta` —
				the legacy alias the JDK still uses for India Standard Time — and the Debian-based
				postgres:17.6 image does not recognise it: `pg_timezone_names` has `Asia/Kolkata` and
				no `Asia/Calcutta`, so every connection is refused with

				    FATAL: invalid value for parameter "TimeZone": "Asia/Calcutta"

				and every container-backed test dies at "Unable to determine Dialect without JDBC
				metadata", which names nothing to do with the actual cause.

				Verified rather than assumed: `SELECT count(*) FROM pg_timezone_names WHERE
				name='Asia/Calcutta'` returns 0 inside that image and 1 for 'Asia/Kolkata'. The
				PostgreSQL 17.11 installed natively on this machine accepts both, which is why the
				pre-chapter baseline run against the dev database passed and only the container path
				fails — a difference between two PostgreSQL builds, not between two versions.

				Fixing it by naming Asia/Kolkata would work here and leave the next machine to
				rediscover it. UTC is the setting that makes the suite independent of where it runs,
				which is the property actually wanted: CartWise stores `Instant` everywhere and
				`timestamp with time zone` in every table, so nothing under test has an opinion about
				the local zone.

				@{argLine} is late evaluation of the property JaCoCo's prepare-agent sets. Writing a
				plain <argLine> here would replace it and silently produce an empty coverage report —
				the agent would never be attached, and the build would stay green while measuring
				nothing.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>

			<!--
				JaCoCo measures which bytecode branches the tests actually executed.

				`prepare-agent` binds to initialize and puts a Java agent on the surefire JVM's
				command line; `report` turns the resulting jacoco.exec into HTML at
				target/site/jacoco/index.html.

				`report` is bound to `test`, not to JaCoCo's own default of `verify`. The default is
				the right one for a project whose pipeline runs `mvn verify`; this one is driven by
				`mvn clean test`, and a report goal bound to a phase that never executes produces no
				report at all while the build still goes green — the worst of both, because it looks
				like coverage is being measured. The binding follows the command that is actually run.

				Deliberately NOT bound: the `check` goal, which fails the build below a coverage
				threshold. A threshold is only meaningful once there is a measured baseline to set
				it from — wiring it before the first report would either pick a number out of the
				air or fail every build until it happened to be met.

				The exclusions are types with no behaviour to cover. Counting a record's generated
				accessors as "uncovered lines" does not describe a risk, it just moves the
				percentage, and a coverage number that can be moved without writing a test is a
				number that stops meaning anything.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<exclude>com/cartwise/CartwiseBackendApplication.class</exclude>
						<exclude>com/cartwise/**/dto/**</exclude>
						<exclude>com/cartwise/config/*Properties.class</exclude>
						<exclude>com/cartwise/**/package-info.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
